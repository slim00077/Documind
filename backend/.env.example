# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Real local PostgreSQL 17 (portable install at C:\Users\salma\pgsql17), replacing the
# experimental `prisma dev` SQLite-backed emulator, which had a reproducible bug causing
# Prisma Studio and native pg_dump/psql to fail under concurrent connections.
# Start with: C:\Users\salma\pgsql17\pgsql\bin\pg_ctl.exe -D C:\Users\salma\pgsql17\data -l C:\Users\salma\pgsql17\logfile.txt -o "-p 5432 -h localhost" start
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/documind?schema=public"

SHADOW_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/documind_shadow?schema=public"

# ROLLBACK: previous `prisma dev` local server values (kept running as of this migration; do not remove
# until the new setup above is fully verified). Restore these two lines and comment out the ones above
# to roll back. Start the old server with: cd backend && npx prisma dev
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

JWT_EXPIRES_IN="7d"

# Embeddings: "local" (default) runs Xenova/all-MiniLM-L6-v2 fully offline via
# @huggingface/transformers, no API key needed. Set to "openai" to use OpenAI's
# embeddings API instead (requires OPENAI_API_KEY below). Whichever provider is
# active must produce 384-dimensional vectors to match the DocumentChunk.embedding
# column (vector(384)); OpenAI's text-embedding-3-* models are requested at exactly
# 384 dimensions via their native `dimensions` parameter to satisfy this.
EMBEDDING_PROVIDER="local"
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSIONS="384"
# OPENAI_API_KEY=""

# LLM (answer generation): multiple providers are supported behind one
# LLMProvider abstraction, tried in order until one succeeds. Order is
# read from LLM_PROVIDER_ORDER (comma-separated ids: gemini, openrouter,
# groq, local, openai, none); if unset, it falls back to the older single
# LLM_PROVIDER value for backward compatibility, and finally to "gemini"
# alone if neither is set. A provider with no API key configured fails
# immediately (as a "fatal/config" error) and is skipped - it does not
# block the rest of the chain.
LLM_PROVIDER_ORDER="gemini,openrouter,groq,openai,local"
# LLM_PROVIDER="gemini"

# How many times to retry the *current* provider on a transient error
# (429/5xx/network) with exponential backoff (LLM_RETRY_BASE_DELAY_MS,
# doubling each attempt) before moving on to the next provider in the chain.
# Auth/config errors and confirmed quota/rate-limit errors are never
# retried - they fail over to the next provider immediately.
LLM_MAX_RETRIES="2"
LLM_RETRY_BASE_DELAY_MS="300"

# --- Usage monitoring (backend terminal logging only) ---
# Warning-level thresholds, as a percentage of each provider's configured
# request limit (see LLM_<PROVIDER>_REQUEST_LIMIT below). Purely for
# terminal visibility; local per-session counters are always logged as
# ESTIMATED unless a provider returns real rate-limit headers (Groq does).
LLM_USAGE_WARN_THRESHOLD="80"
LLM_USAGE_HIGH_THRESHOLD="90"
LLM_USAGE_CRITICAL_THRESHOLD="95"
# How long (seconds) to deprioritize a provider after it returns a
# quota/rate-limit error, before trying it again.
LLM_QUOTA_COOLDOWN_SECONDS="300"
# Optional daily request budgets, purely to drive the WARN/HIGH/CRITICAL
# logging above and proactive skipping - set to your own plan's real limits.
# Unset/0 = unlimited (no threshold logging for that provider).
# LLM_GEMINI_REQUEST_LIMIT="1500"
# LLM_OPENROUTER_REQUEST_LIMIT="50"
# LLM_GROQ_REQUEST_LIMIT="14400"

# 1) Gemini - free tier (Flash-tier models are free of charge on a Google AI
# Studio API key - no credit card required). Get a key at
# https://aistudio.google.com/apikey.
LLM_MODEL="gemini-3.6-flash"
# Comma-separated models to try, in order, if LLM_MODEL fails transiently
# (429/5xx/network) after its retries, or doesn't exist for this API key
# (404). Defaults to "gemini-flash-latest,gemini-2.5-flash" if unset -
# "gemini-flash-latest" is a Google-maintained alias that always points to a
# current stable flash model, so it doesn't need to be updated over time.
# LLM_FALLBACK_MODELS="gemini-flash-latest,gemini-2.5-flash"
GEMINI_API_KEY=""

# 2) OpenRouter - free models available with just an email signup (no card).
# Get a key at https://openrouter.ai/keys. Default model "openrouter/free"
# is OpenRouter's own self-updating router across whichever models are
# currently free, so it never goes stale.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openrouter/free"

# 3) Groq - permanent free tier, very fast inference. Get a key at
# https://console.groq.com/keys. Default model "llama-3.1-8b-instant" is
# Groq's fastest/cheapest current model; see https://console.groq.com/docs/models
# for the full current list if you want a different one.
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.1-8b-instant"

# 4) Local (Ollama) - final fallback, no API key, works fully offline once
# installed. Install Ollama, run `ollama serve`, then `ollama pull
# <model>` for whichever OLLAMA_MODEL you configure below.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# OpenAI (paid, not part of the default free-tier chain) - add "openai" to
# LLM_PROVIDER_ORDER to use it.
# OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
# Production: comma-separated list of allowed frontend origins (e.g. https://app.example.com).
# CORS_ORIGIN=

# Public URL of the frontend, used to build invitation links (/invite/<token>). Email delivery is not
# configured: invitation links are shown once to the inviter to copy and send.
# FRONTEND_URL=http://localhost:5173

# --- Production (Render / Docker / Kubernetes) ---
# NODE_ENV=production   (enables the Ollama production guard)
# PORT is injected by the platform (Render: 10000). Locally it defaults to 3000.
# In production remove "local" from LLM_PROVIDER_ORDER unless OLLAMA_BASE_URL points to a
# reachable remote Ollama server: localhost:11434 on a cloud host is the server itself.
# Uploaded files are written to <working dir>/uploads (Docker image: /app/uploads); mount
# persistent storage there (Render disk / Kubernetes PVC / docker volume).
