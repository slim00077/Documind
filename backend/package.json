{
  "scripts": {
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts\\ensure-postgres-running.ps1\"",
    "db:stop": "powershell -NoProfile -Command \"Stop-Service -Name postgresql-x64-18\"",
    "db:studio": "npm run db:start && prisma studio",
    "predev": "npm run db:start",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js"
  },
